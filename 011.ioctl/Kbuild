# 011.ioctl - kernel build rules.
# Builds main.c into the module file myioctl.ko.
# user_app.c is built with plain gcc by the Makefile (see README).

obj-m := myioctl.o
myioctl-objs := main.o

# Rust twin (main.rs) needs a CONFIG_RUST=y kernel (on Arch: linux-rust)
# plus a matching rustup toolchain. See README.md.
